# Documentation only. Blank values keep analytics disabled. Never commit a real .env.
ANALYTICS_ENABLED=false
ANALYTICS_ORIGIN=https://portfolioruzzeldulay.netlify.app
ANALYTICS_ENVIRONMENT=production
# Dedicated Neon/PostgreSQL connection string, Functions scope, production only.
ANALYTICS_DATABASE_URL=
# Generate interactively with npm run analytics:password.
ANALYTICS_SESSION_SECRET=
ANALYTICS_ADMIN_PASSWORD_HASH=

# Managed database selected for this site; optional standalone URL above is unused.
ANALYTICS_DATABASE_PROVIDER=netlify
